domain Integer

print("=== Integer exponentiation ===")
print(2 ^ 3)
print(2 ^ 0)
print(2 ^ -3)

print("=== Exact Rational powers ===")
print(1.5 ^ 2)
print(2 ^ 3)
print(2 ^ -3)

print("=== Rational exponents ===")
print(9 ^ 0.5)
print(2 ^ 0.5)
print(2 ^ (1.0 / 3.0))
print(2 ^ (3.0 / 2.0))

print("=== Negative bases with odd denominators ===")
print((-8) ^ (1.0 / 3.0))
print((-8) ^ (2.0 / 3.0))
print((-8) ^ (-1.0 / 3.0))

print("=== Real exponents ===")
print(2e0 ^ 3.5)
print(2 ^ 3e0)

print("=== Variable exponents ===")
var n: Integer = -3
print(2 ^ n)

var r: Rational = 1.0 / 3.0
print((-27) ^ r)

var x: Real = 2.0
print(x ^ 3.5)