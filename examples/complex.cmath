domain Complex

def combine(a: Complex, b: Complex) -> Complex:
    return a + b

let a: Complex = 2 + 3 * Complex.i
let b: Complex = 4 - 2 * Complex.i

print("=== Complex constants ===")
print(Complex.i)
print(Complex.Imaginary)

print("=== Complex arithmetic ===")
print(a)
print(b)
print(a + b)
print(a - b)
print(a * b)
print(a / b)

print("=== Unary operations ===")
print(-a)

print("=== Numeric promotion ===")
print(2 + Complex.i)
print(2.5 + Complex.i)
print(5 + 2 * Complex.i)

print("=== Comparisons ===")
print(a == a)
print(a == b)
print(a != b)
print(Complex.i == Complex.Imaginary)

print("=== Functions ===")
print(combine(a, b))

print("=== Complex exponentiation ===")

print(Complex.i ^ 2)
print(Complex.i ^ -2)
print(Complex.i ^ 0.5)
print((-1) ^ Complex.i)
print(2 ^ Complex.i)
print(Complex.i ^ Complex.i)
print((1 + Complex.i) ^ (2 - Complex.i))

print("=== Zero-base behavior ===")

print(0 ^ 0)
print(0 ^ 2)